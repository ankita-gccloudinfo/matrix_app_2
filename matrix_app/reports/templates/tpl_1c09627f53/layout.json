0; }\n        .platform-whatsapp { background-color: #25d366; }\n        .chart-bar {\n            transition: height 0.5s ease;\n        }\n    </style>\n</head>", "tagged_body_html": "<body class=\"bg-gray-50\">\n<div class=\"max-w-4xl mx-auto p-6 bg-white shadow-lg\">\n<!-- Header -->\n<header class=\"mb-8 pb-6 border-b border-gray-200\">\n<div class=\"flex justify-between items-start\">\n<div>\n<h1 class=\"text-3xl font-bold text-primary\">SOCIAL MEDIA INTELLIGENCE REPORT</h1>\n<p class=\"text-gray-600 mt-2\">Monitoring &amp; Analysis Dashboard</p>\n</div>\n<div class=\"text-right\">\n<p class=\"text-sm text-gray-500\">Report Generated</p>\n<p class=\"font-semibold\">June 15, 2023</p>\n<p class=\"text-xs text-gray-500 mt-1\">09:30 AM UTC</p>\n</div>\n</div>\n<div class=\"mt-4 flex items-center\">\n<span class=\"inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-blue-100 text-blue-800\">\n<i class=\"fas fa-shield-alt mr-2\"></i> Security Level: Medium\n                </span>\n<span class=\"ml-3 inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-green-100 text-green-800\">\n<i class=\"fas fa-chart-line mr-2\"></i> Active Monitoring\n                </span>\n</div>\n</header>\n<!-- Summary Stats -->\n<section class=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 mb-8\">\n<div class=\"card bg-white p-5 rounded-lg border border-gray-200\">\n<div class=\"flex justify-between items-start\">\n<div>\n<p class=\"text-sm text-gray-500\">Total Mentions</p>\n<p class=\"text-2xl font-bold mt-1\" data-slot=\"s1\">1,284</p>\n</div>\n<div class=\"bg-blue-100 p-2 rounded-lg\">\n<i class=\"fas fa-comments text-blue-600 text-xl\"></i>\n</div>\n</div>\n<div class=\"mt-3\">\n<div class=\"flex items-center text-sm text-green-600\">\n<i class=\"fas fa-arrow-up mr-1\"></i> 12% from last period\n                    </div>\n</div>\n</div>\n<div class=\"card bg-white p-5 rounded-lg border border-gray-200\">\n<div class=\"flex justify-between items-start\">\n<div>\n<p class=\"text-sm text-gray-500\">Engagement Rate</p>\n<p class=\"text-2xl font-bold mt-1\" data-slot=\"s2\">3.4%</p>\n</div>\n<div class=\"bg-green-100 p-2 rounded-lg\">\n<i class=\"fas fa-heart text-green-600 text-xl\"></i>\n</div>\n</div>\n<div class=\"mt-3\">\n<div class=\"flex items-center text-sm text-red-600\">\n<i class=\"fas fa-arrow-down mr-1\"></i> 2% from last period\n                    </div>\n</div>\n</div>\n<div class=\"card bg-white p-5 rounded-lg border border-gray-200\">\n<div class=\"flex justify-between items-start\">\n<div>\n<p class=\"text-sm text-gray-500\">Active Platforms</p>\n<p class=\"text-2xl font-bold mt-1\" data-slot=\"s3\">5</p>\n</div>\n<div class=\"bg-purple-100 p-2 rounded-lg\">\n<i class=\"fas fa-globe text-purple-600 text-xl\"></i>\n</div>\n</div>\n<div class=\"mt-3\">\n<div class=\"flex items-center text-sm text-green-600\">\n<i class=\"fas fa-plus mr-1\"></i> 1 new platform\n                    </div>\n</div>\n</div>\n<div class=\"card bg-white p-5 rounded-lg border border-gray-200\">\n<div class=\"flex justify-between items-start\">\n<div>\n<p class=\"text-sm text-gray-500\">Alert Level</p>\n<p class=\"text-2xl font-bold mt-1\">Medium</p>\n</div>\n<div class=\"bg-yellow-100 p-2 rounded-lg\">\n<i class=\"fas fa-exclamation-triangle text-yellow-600 text-xl\"></i>\n</div>\n</div>\n<div class=\"mt-3\">\n<div class=\"flex items-center text-sm text-yellow-600\">\n<i class=\"fas fa-clock mr-1\"></i> Last updated: 2 hours ago\n                    </div>\n</div>\n</div>\n</section>\n<!-- Main Content Grid -->\n<div class=\"grid grid-cols-1 lg:grid-cols-3 gap-6 mb-8\">\n<!-- Left Column -->\n<div class=\"lg:col-span-2 space-y-6\">\n<!-- Sentiment Analysis -->\n<section class=\"card bg-white p-6 rounded-lg border border-gray-200\">\n<h2 class=\"text-xl font-bold text-primary mb-4 flex items-center\">\n<i class=\"fas fa-chart-pie mr-2 text-blue-600\"></i> Sentiment Analysis\n                    </h2>\n<div class=\