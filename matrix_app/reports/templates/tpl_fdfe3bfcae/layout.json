{"head_html": "<head>\n<meta charset=\"utf-8\"/>\n<meta content=\"width=device-width, initial-scale=1.0\" name=\"viewport\"/>\n<title>Intelligence Report - Social Media Monitoring</title>\n<script src=\"https://cdn.tailwindcss.com\"></script>\n<link href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css\" rel=\"stylesheet\"/>\n<script>\n        tailwind.config = {\n            theme: {\n                extend: {\n                    colors: {\n                        primary: '#1e40af',\n                        secondary: '#3b82f6',\n                        accent: '#f59e0b',\n                        dark: '#1e293b',\n                        light: '#f8fafc'\n                    }\n                }\n            }\n        }\n    </script>\n<style>\n        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');\n        body {\n            font-family: 'Inter', sans-serif;\n            background-color: #f8fafc;\n            color: #1e293b;\n        }\n        .card {\n            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);\n            transition: all 0.3s ease;\n        }\n        .card:hover {\n            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);\n        }\n        .sentiment-negative {\n            background-color: #fee2e2;\n            color: #dc2626;\n        }\n        .sentiment-neutral {\n            background-color: #fef3c7;\n            color: #d97706;\n        }\n        .sentiment-positive {\n            background-color: #d1fae5;\n            color: #047857;\n        }\n        .chart-bar {\n            transition: height 0.5s ease;\n        }\n        .section-header {\n            border-bottom: 2px solid #e2e8f0;\n            padding-bottom: 0.5rem;\n            margin-bottom: 1.5rem;\n        }\n        @media print {\n            body {\n                background-color: white;\n            }\n            .no-print {\n                display: none !important;\n            }\n        }\n    </style>\n</head>", "tagged_body_html": "<body class=\"bg-gray-50\">\n<div class=\"max-w-4xl mx-auto p-6 bg-white shadow-lg\">\n<!-- Header -->\n<header class=\"mb-8 pb-4 border-b border-gray-200\">\n<div class=\"flex justify-between items-start\">\n<div>\n<h1 class=\"text-3xl font-bold text-primary\">Social Media Intelligence Report</h1>\n<p class=\"text-gray-600 mt-2\">Monitoring &amp; Analysis Dashboard</p>\n</div>\n<div class=\"text-right\">\n<p class=\"text-sm text-gray-500\">Report Date</p>\n<p class=\"font-semibold\">October 15, 2023</p>\n<p class=\"text-sm text-gray-500 mt-1\">Period</p>\n<p class=\"font-semibold\">Last 24 Hours</p>\n</div>\n</div>\n</header>\n<!-- Summary Stats -->\n<section class=\"mb-8\">\n<div class=\"grid grid-cols-1 md:grid-cols-4 gap-4\">\n<div class=\"card p-4 bg-white rounded-lg\">\n<div class=\"flex items-center\">\n<div class=\"p-3 rounded-full bg-blue-100 text-blue-600 mr-3\">\n<i class=\"fas fa-comments\"></i>\n</div>\n<div>\n<p class=\"text-sm text-gray-500\">Total Mentions</p>\n<p class=\"text-2xl font-bold\" data-slot=\"s1\">1,284</p>\n</div>\n</div>\n</div>\n<div class=\"card p-4 bg-white rounded-lg\">\n<div class=\"flex items-center\">\n<div class=\"p-3 rounded-full bg-green-100 text-green-600 mr-3\">\n<i class=\"fas fa-chart-line\"></i>\n</div>\n<div>\n<p class=\"text-sm text-gray-500\">Engagement Rate</p>\n<p class=\"text-2xl font-bold\" data-slot=\"s2\">4.7%</p>\n</div>\n</div>\n</div>\n<div class=\"card p-4 bg-white rounded-lg\">\n<div class=\"flex items-center\">\n<div class=\"p-3 rounded-full bg-purple-100 text-purple-600 mr-3\">\n<i class=\"fas fa-users\"></i>\n</div>\n<div>\n<p class=\"text-sm text-gray-500\">Unique Accounts</p>\n<p class=\"text-2xl font-bold\" data-slot=\"s3\">342</p>\n</div>\n</div>\n</div>\n<div class=\"card p-4 bg-white rounded-lg\">\n<div class=\"flex items-center\">\n<div class=\"p-3 rounded-full bg-orange-100 text-orange-600 mr-3\">\n<i class=\"fas fa-globe-americas\"></i>\n</div>\n<div>\n<p class=\"text-sm text-gray-500\">Platforms Monitored</p>\n<p class=\"text-2xl font-bold\" data-slot=\"s4\">5</p>\n</div>\n</div>\n</div>\n</div>\n</section>\n<!-- Sentiment Analysis -->\n<section class=\"mb-8\">\n<h2 class=\"section-header text-xl font-bold text-dark\">Sentiment Analysis</h2>\n<div class=\"grid grid-cols-1 md:grid-cols-3 gap-4\">\n<div class=\"card p-4 bg-white rounded-lg\">\n<div class=\"flex justify-between mb-2\">\n<span class=\"text-sm font-medium\">Negative</span>\n<span class=\"text-sm font-medium\" data-slot=\"s5\">32%</span>\n</div>\n<div class=\"w-full bg-gray-200 rounded-full h-2.5\">\n<div class=\"bg-red-500 h-2.5 rounded-full\" style=\"width: 32%\"></div>\n</div>\n</div>\n<div class=\"card p-4 bg-white rounded-lg\">\n<div class=\"flex justify-between mb-2\">\n<span class=\"text-sm font-medium\">Neutral</span>\n<span class=\"text-sm font-medium\" data-slot=\"s6\">45%</span>\n</div>\n<div class=\"w-full bg-gray-200 rounded-full h-2.5\">\n<div class=\"bg-yellow-500 h-2.5 rounded-full\" style=\"width: 45%\"></div>\n</div>\n</div>\n<div class=\"card p-4 bg-white rounded-lg\">\n<div class=\"flex justify-between mb-2\">\n<span class=\"text-sm font-medium\">Positive</span>\n<span class=\"text-sm font-medium\" data-slot=\"s7\">23%</span>\n</div>\n<div class=\"w-full bg-gray-200 rounded-full h-2.5\">\n<div class=\"bg-green-500 h-2.5 rounded-full\" style=\"width: 23%\"></div>\n</div>\n</div>\n</div>\n</section>\n<!-- Platform Distribution -->\n<section class=\"mb-8\">\n<h2 class=\"section-header text-xl font-bold text-dark\">Platform Distribution</h2>\n<div class=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-4\">\n<div class=\"card p-4 bg-white rounded-lg flex flex-col items-center\">\n<div class=\"w-16 h-16 rounded-full bg-blue-100 flex items-center justify-center mb-2\">\n<i class=\"fab fa-twitter text-blue-600 text-xl\"></i>\n</div>\n<p class=\"font-semibold\">Twitter</p>\n<p class=\"text-2xl font-bold\" data-slot=\"s8\">42%</p>\n</div>\n<div class=\"card p-4 bg-white rounded-lg flex flex-col items-center\">\n<div class=\"w-16 h-16 rounded-full bg-pink-100 flex items-center justify-center mb-2\">\n<i class=\"fab fa-instagram text-pink-600 text-xl\"></i>\n</div>\n<p class=\"font-semibold\">Instagram</p>\n<p class=\"text-2xl font-bold\" data-slot=\"s9\">28%</p>\n</div>\n<div class=\"card p-4 bg-white rounded-lg flex flex-col items-center\">\n<div class=\"w-16 h-16 rounded-full bg-blue-200 flex items-center justify-center mb-2\">\n<i class=\"fab fa-facebook text-blue-700 text-xl\"></i>\n</div>\n<p class=\"font-semibold\">Facebook</p>\n<p class=\"text-2xl font-bold\" data-slot=\"s10\">15%</p>\n</div>\n<div class=\"card p-4 bg-white rounded-lg flex flex-col items-center\">\n<div class=\"w-16 h-16 rounded-full bg-red-100 flex items-center justify-center mb-2\">\n<i class=\"fab fa-youtube text-red-600 text-xl\"></i>\n</div>\n<p class=\"font-semibold\">YouTube</p>\n<p class=\"text-2xl font-bold\" data-slot=\"s11\">10%</p>\n</div>\n<div class=\"card p-4 bg-white rounded-lg flex flex-col items-center\">\n<div class=\"w-16 h-16 rounded-full bg-green-100 flex items-center justify-center mb-2\">\n<i class=\"fab fa-whatsapp text-green-600 text-xl\"></i>\n</div>\n<p class=\"font-semibold\">WhatsApp</p>\n<p class=\"text-2xl font-bold\" data-slot=\"s12\">5%</p>\n</div>\n</div>\n</section>\n<!-- Top Posts -->\n<section class=\"mb-8\">\n<h2 class=\"section-header text-xl font-bold text-dark\">Top Posts</h2>\n<div class=\"space-y-4\">\n<div class=\"card p-4 bg-white rounded-lg\">\n<div class=\"flex justify-between\">\n<div>\n<p class=\"font-semibold\">John Smith (@johnsmith)</p>\n<p class=\"text-sm text-gray-500\">Twitter \u2022 2 hours ago</p>\n</div>\n<span class=\"sentiment-negative px-2 py-1 rounded text-xs font-semibold\">Negative</span>\n</div>\n<p class=\"mt-2\" data-slot=\"s13\">Breaking: Local police department under investigation for alleged misconduct. This is a serious matter that requires immediate attention from authorities.</p>\n<div class=\"mt-3 flex space-x-2\">\n<span class=\"text-xs text-gray-500\">Likes: 42</span>\n<span class=\"text-xs text-gray-500\">Comments: 8</span>\n<span class=\"text-xs text-gray-500\">Shares: 3</span>\n</div>\n</div>\n<div class=\"card p-4 bg-white rounded-lg\">\n<div class=\"flex justify-between\">\n<div>\n<p class=\"font-semibold\">Sarah Johnson (@sarahj)</p>\n<p class=\"text-sm text-gray-500\">Instagram \u2022 4 hours ago</p>\n</div>\n<span class=\"sentiment-positive px-2 py-1 rounded text-xs font-semibold\">Positive</span>\n</div>\n<p class=\"mt-2\" data-slot=\"s14\">Great job by our local police force today! Their community outreach program has made a real difference in our neighborhood. #CommunitySafety</p>\n<div class=\"mt-3 flex space-x-2\">\n<span class=\"text-xs text-gray-500\">Likes: 128</span>\n<span class=\"text-xs text-gray-500\">Comments: 15</span>\n<span class=\"text-xs text-gray-500\">Shares: 7</span>\n</div>\n</div>\n</div>\n</section>\n<!-- Engagement Metrics -->\n<section class=\"mb-8\">\n<h2 class=\"section-header text-xl font-bold text-dark\">Engagement Metrics</h2>\n<div class=\"grid grid-cols-1 md:grid-cols-4 gap-4\">\n<div class=\"card p-4 bg-white rounded-lg\">\n<p class=\"text-sm text-gray-500\">Total Likes</p>\n<p class=\"text-2xl font-bold\" data-slot=\"s15\">3,421</p>\n</div>\n<div class=\"card p-4 bg-white rounded-lg\">\n<p class=\"text-sm text-gray-500\">Total Comments</p>\n<p class=\"text-2xl font-bold\" data-slot=\"s16\">892</p>\n</div>\n<div class=\"card p-4 bg-white rounded-lg\">\n<p class=\"text-sm text-gray-500\">Total Shares</p>\n<p class=\"text-2xl font-bold\" data-slot=\"s17\">247</p>\n</div>\n<div class=\"card p-4 bg-white rounded-lg\">\n<p class=\"text-sm text-gray-500\">Total Views</p>\n<p class=\"text-2xl font-bold\" data-slot=\"s18\">12,840</p>\n</div>\n</div>\n</section>\n<!-- Trending Topics -->\n<section class=\"mb-8\">\n<h2 class=\"section-header text-xl font-bold text-dark\">Trending Topics</h2>\n<div class=\"flex flex-wrap gap-2\">\n<span class=\"bg-blue-100 text-blue-800 px-3 py-1 rounded-full text-sm\">#PoliceReform</span>\n<span class=\"bg-green-100 text-green-800 px-3 py-1 rounded-full text-sm\">#CommunitySafety</span>\n<span class=\"bg-yellow-100 text-yellow-800 px-3 py-1 rounded-full text-sm\">#LawEnforcement</span>\n<span class=\"bg-purple-100 text-purple-800 px-3 py-1 rounded-full text-sm\">#PublicSafety</span>\n<span class=\"bg-red-100 text-red-800 px-3 py-1 rounded-full text-sm\">#LocalNews</span>\n</div>\n</section>\n<!-- Intelligence Summary -->\n<section class=\"mb-8\">\n<h2 class=\"section-header text-xl font-bold text-dark\">Intelligence Summary</h2>\n<div class=\"card p-4 bg-white rounded-lg\">\n<p class=\"mb-3\" data-slot=\"s19\">The monitoring period has yielded a moderate volume of social media activity related to local law enforcement. Key themes include public safety concerns, community engagement efforts, and ongoing discussions about police reform.</p>\n<p class=\"mb-3\" data-slot=\"s20\">Sentiment analysis indicates a mixed response to recent developments, with negative sentiment representing 32% of total mentions. Positive sentiment remains steady at 23%, suggesting continued public interest in community policing initiatives.</p>\n<p data-slot=\"s21\">Recommendation: Continue monitoring for escalation in negative sentiment trends and maintain engagement with community stakeholders to address concerns proactively.</p>\n</div>\n</section>\n<!-- Footer -->\n<footer class=\"pt-4 border-t border-gray-200 text-center text-sm text-gray-500\">\n<p data-slot=\"s22\">\u00a9 2023 Police Intelligence Monitoring System | Confidential Report</p>\n</footer>\n</div>\n</body>", "slots": [{"slot_id": "s1", "slot_type": "stat_number", "sample_text": "1,284", "context_label": "Total Mentions", "chips": [], "meaning_text": "", "maps_to": null,