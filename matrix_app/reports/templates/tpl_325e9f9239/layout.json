v class=\"border-b border-gray-100 pb-4 last:border-0 last:pb-0\">\n<div class=\"flex justify-between\">\n<div class=\"flex items-center\">\n<div class=\"bg-gray-200 border-2 border-dashed rounded-xl w-10 h-10\"></div>\n<div class=\"ml-3\">\n<div class=\"font-medium\">Sarah J.</div>\n<div class=\"text-xs text-gray-500\">Twitter/X \u2022 2 hours ago</div>\n</div>\n</div>\n<span class=\"sentiment-negative font-medium text-sm\">Negative</span>\n</div>\n<p class=\"mt-2 text-gray-700\" data-slot=\"s16\">Just witnessed suspicious activity near the downtown plaza. Security needs to be increased immediately.</p>\n<div class=\"mt-2 flex items-center\">\n<span class=\"text-xs text-gray-500\">#suspiciousactivity #downtown #safety</span>\n</div>\n</div>\n<!-- Post Card 2 -->\n<div class=\"border-b border-gray-100 pb-4 last:border-0 last:pb-0\">\n<div class=\"flex justify-between\">\n<div class=\"flex items-center\">\n<div class=\"bg-gray-200 border-2 border-dashed rounded-xl w-10 h-10\"></div>\n<div class=\"ml-3\">\n<div class=\"font-medium\">Mike T.</div>\n<div class=\"text-xs text-gray-500\">Instagram \u2022 4 hours ago</div>\n</div>\n</div>\n<span class=\"sentiment-positive font-medium text-sm\">Positive</span>\n</div>\n<p class=\"mt-2 text-gray-700\" data-slot=\"s17\">Great job by the local police team during today's community outreach event. Community spirit is strong!</p>\n<div class=\"mt-2 flex items-center\">\n<span class=\"text-xs text-gray-500\">#communityoutreach #police #safety</span>\n</div>\n</div>\n</div>\n</div>\n</div>\n</div>\n</div>\n<!-- Additional Metrics -->\n<div class=\"mb-8\">\n<h2 class=\"text-xl font-bold text-gray-800 mb-4 flex items-center\">\n<i class=\"fas fa-chart-bar mr-2 text-primary\"></i> Additional Metrics\n            </h2>\n<div class=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6\">\n<div class=\"card kpi-card p-6\">\n<div class=\"text-gray-500 text-sm\">Volume Anomalies</div>\n<div class=\"text-2xl font-bold mt-1\" data-slot=\"s1