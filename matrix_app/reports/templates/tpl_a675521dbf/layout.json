{"head_html": "<head>\n<meta charset=\"utf-8\"/>\n<meta content=\"width=device-width, initial-scale=1.0\" name=\"viewport\"/>\n<title>Social Media Intelligence Report</title>\n<script src=\"https://cdn.tailwindcss.com\"></script>\n<link href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css\" rel=\"stylesheet\"/>\n<script>\n        tailwind.config = {\n            theme: {\n                extend: {\n                    colors: {\n                        primary: '#4f46e5',\n                        secondary: '#0d9488',\n                        accent: '#10b981',\n                        dark: '#1e293b',\n                        light: '#f8fafc'\n                    }\n                }\n            }\n        }\n    </script>\n<style>\n        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');\n        body {\n            font-family: 'Inter', sans-serif;\n            background-color: #f1f5f9;\n        }\n        .card {\n            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);\n            border-radius: 12px;\n            transition: all 0.3s ease;\n        }\n        .card:hover {\n            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);\n        }\n        .gradient-bg {\n            background: linear-gradient(135deg, #4f46e5 0%, #0d9488 100%);\n        }\n        .sentiment-negative {\n            background-color: #fee2e2;\n            color: #dc2626;\n        }\n        .sentiment-neutral {\n            background-color: #fef3c7;\n            color: #d97706;\n        }\n        .sentiment-positive {\n            background-color: #dcfce7;\n            color: #16a34a;\n        }\n        .chart-bar {\n            transition: height 0.5s ease;\n        }\n    </style>\n</head>", "tagged_body_html": "<body class=\"bg-gray-100 min-h-screen p-4 md:p-8\">\n<div class=\"max-w-6xl mx-auto\">\n<!-- Header Banner -->\n<div class=\"gradient-bg text-white rounded-xl p-6 mb-8\">\n<div class=\"flex flex-col md:flex-row justify-between items-start md:items-center\">\n<div>\n<h1 class=\"text-2xl md:text-3xl font-bold\">Social Media Intelligence Report</h1>\n<p class=\"mt-2 opacity-90\">Real-time monitoring &amp; analysis dashboard</p>\n</div>\n<div class=\"mt-4 md:mt-0 bg-white/20 backdrop-blur-sm rounded-lg p-4\">\n<div class=\"text-center\">\n<p class=\"text-sm opacity-80\">Total Volume</p>\n<p class=\"text-2xl font-bold\">1,284 posts</p>\n</div>\n</div>\n</div>\n<div class=\"mt-6 grid grid-cols-2 md:grid-cols-4 gap-4\">\n<div class=\"bg-white/10 backdrop-blur-sm rounded-lg p-3\">\n<p class=\"text-xs opacity-80\">Top District</p>\n<p class=\"font-semibold\">Downtown</p>\n</div>\n<div class=\"bg-white/10 backdrop-blur-sm rounded-lg p-3\">\n<p class=\"text-xs opacity-80\">Active Alerts</p>\n<p class=\"font-semibold\" data-slot=\"s1\">12</p>\n</div>\n<div class=\"bg-white/10 backdrop-blur-sm rounded-lg p-3\">\n<p class=\"text-xs opacity-80\">Severity Level</p>\n<p class=\"font-semibold text-yellow-300\">Medium</p>\n</div>\n<div class=\"bg-white/10 backdrop-blur-sm rounded-lg p-3\">\n<p class=\"text-xs opacity-80\">Last Update</p>\n<p class=\"font-semibold\">2 hours ago</p>\n</div>\n</div>\n</div>\n<!-- Main Content Grid -->\n<div class=\"grid grid-cols-1 lg:grid-cols-3 gap-6 mb-8\">\n<!-- Sentiment Analysis -->\n<div class=\"card bg-white p-6\">\n<h2 class=\"text-xl font-bold text-gray-800 mb-4 flex items-center\">\n<i class=\"fas fa-chart-pie mr-2 text-primary\"></i> Sentiment Analysis\n                </h2>\n<div class=\"flex justify-between items-center mb-4\">\n<div class=\"text-center\">\n<p class=\"text-3xl font-bold text-red-500\" data-slot=\"s2\">32%</p>\n<p class=\"text-sm text-gray-600\">Negative</p>\n</div>\n<div class=\"text-center\">\n<p class=\"text-3xl font-bold text-yellow-500\" data-slot=\"s3\">45%</p>\n<p class=\"text-sm text-gray-600\">Neutral</p>\n</div>\n<div class=\"text-center\">\n<p class=\"text-3xl font-bold text-green-500\" data-slot=\"s4\">23%</p>\n<p class=\"text-sm text-gray-600\">Positive</p>\n</div>\n</div>\n<div class=\"h-32 w-full flex items-end justify-between space-x-2 mt-6\">\n<div class=\"flex flex-col items-center w-full\">\n<div class=\"w-3/4 bg-red-500 rounded-t-md\" style=\"height: 32%\"></div>\n<span class=\"text-xs mt-1\">Negative</span>\n</div>\n<div class=\"flex flex-col items-center w-full\">\n<div class=\"w-3/4 bg-yellow-500 rounded-t-md\" style=\"height: 45%\"></div>\n<span class=\"text-xs mt-1\">Neutral</span>\n</div>\n<div class=\"flex flex-col items-center w-full\">\n<div class=\"w-3/4 bg-green-500 rounded-t-md\" style=\"height: 23%\"></div>\n<span class=\"text-xs mt-1\">Positive</span>\n</div>\n</div>\n</div>\n<!-- Platform Breakdown -->\n<div class=\"card bg-white p-6\">\n<h2 class=\"text-xl font-bold text-gray-800 mb-4 flex items-center\">\n<i class=\"fas fa-globe mr-2 text-secondary\"></i> Platform Breakdown\n                </h2>\n<div class=\"space-y-3\">\n<div class=\"flex justify-between items-center\">\n<div class=\"flex items-center\">\n<div class=\"w-3 h-3 rounded-full bg-blue-500 mr-2\"></div>\n<span>Twitter/X</span>\n</div>\n<span class=\"font-semibold\" data-slot=\"s5\">34%</span>\n</div>\n<div class=\"w-full bg-gray-200 rounded-full h-2\">\n<div class=\"bg-blue-500 h-2 rounded-full\" style=\"width: 34%\"></div>\n</div>\n<div class=\"flex justify-between items-center\">\n<div class=\"flex items-center\">\n<div class=\"w-3 h-3 rounded-full bg-pink-500 mr-2\"></div>\n<span>Instagram</span>\n</div>\n<span class=\"font-semibold\" data-slot=\"s6\">28%</span>\n</div>\n<div class=\"w-full bg-gray-200 rounded-full h-2\">\n<div class=\"bg-pink-500 h-2 rounded-full\" style=\"width: 28%\"></div>\n</div>\n<div class=\"flex justify-between items-center\">\n<div class=\"flex items-center\">\n<div class=\"w-3 h-3 rounded-full bg-blue-400 mr-2\"></div>\n<span>Facebook</span>\n</div>\n<span class=\"font-semibold\" data-slot=\"s7\">22%</span>\n</div>\n<div class=\"w-full bg-gray-200 rounded-full h-2\">\n<div class=\"bg-blue-400 h-2 rounded-full\" style=\"width: 22%\"></div>\n</div>\n<div class=\"flex justify-between items-center\">\n<div class=\"flex items-center\">\n<div class=\"w-3 h-3 rounded-full bg-red-500 mr-2\"></div>\n<span>YouTube</span>\n</div>\n<span class=\"font-semibold\" data-slot=\"s8\">10%</span>\n</div>\n<div class=\"w-full bg-gray-200 rounded-full h-2\">\n<div class=\"bg-red-500 h-2 rounded-full\" style=\"width: 10%\"></div>\n</div>\n<div class=\"flex justify-between items-center\">\n<div class=\"flex items-center\">\n<div class=\"w-3 h-3 rounded-full bg-green-500 mr-2\"></div>\n<span>WhatsApp</span>\n</div>\n<span class=\"font-semibold\" data-slot=\"s9\">6%</span>\n</div>\n<div class=\"w-full bg-gray-200 rounded-full h-2\">\n<div class=\"bg-green-500 h-2 rounded-full\" style=\"width: 6%\"></div>\n</div>\n</div>\n</div>\n<!-- Engagement Metrics -->\n<div class=\"card bg-white p-6\">\n<h2 class=\"text-xl font-bold text-gray-800 mb-4 flex items-center\">\n<i class=\"fas fa-fire mr-2 text-accent\"></i> Engagement Metrics\n                </h2>\n<div class=\"grid grid-cols-2 gap-4\">\n<div class=\"bg-blue-50 rounded-lg p-4 text-center\">\n<p class=\"text-2xl font-bold text-blue-600\" data-slot=\"s10\">1,284</p>\n<p class=\"text-sm text-gray-600\">Total Posts</p>\n</div>\n<div class=\"bg-green-50 rounded-lg p-4 text-center\">\n<p class=\"text-2xl font-bold text-green-600\" data-slot=\"s11\">2,456</p>\n<p class=\"text-sm text-gray-600\">Likes</p>\n</div>\n<div class=\"bg-yellow-50 rounded-lg p-4 text-center\">\n<p class=\"text-2xl font-bold text-yellow-600\" data-slot=\"s12\">892</p>\n<p class=\"text-sm text-gray-600\">Comments</p>\n</div>\n<div class=\"bg-purple-50 rounded-lg p-4 text-center\">\n<p class=\"text-2xl font-bold text-purple-600\" data-slot=\"s13\">1,763</p>\n<p class=\"text-sm text-gray-600\">Shares</p>\n</div>\n</div>\n<div class=\"mt-4 pt-4 border-t border-gray-200\">\n<div class=\"flex justify-between items-center mb-2\">\n<span class=\"text-sm text-gray-600\">Views</span>\n<span class=\"font-semibold\" data-slot=\"s14\">3,421</span>\n</div>\n<div class=\"w-full bg-gray-200 rounded-full h-2\">\n<div class=\"bg-indigo-500 h-2 rounded-full\" style=\"width: 75%\"></div>\n</div>\n</div>\n</div>\n</div>\n<!-- Keywords and Hashtags -->\n<div class=\"card bg-white p-6 mb-8\">\n<h2 class=\"text-xl font-bold text-gray-800 mb-4 flex items-center\">\n<i class=\"fas fa-tags mr-2 text-primary\"></i> Key Topics &amp; Hashtags\n            </h2>\n<div class=\"flex flex-wrap gap-2\">\n<span class=\"px-3 py-1 bg-blue-100 text-blue-800 rounded-full text-sm font-medium\">#CommunitySafety</span>\n<span class=\"px-3 py-1 bg-green-100 text-green-800 rounded-full text-sm font-medium\">#PublicAlerts</span>\n<span class=\"px-3 py-1 bg-purple-100 text-purple-800 rounded-full text-sm font-medium\">#CrimePrevention</span>\n<span class=\"px-3 py-1 bg-yellow-100 text-yellow-800 rounded-full text-sm font-medium\">#EmergencyResponse</span>\n<span class=\"px-3 py-1 bg-red-100 text-red-800 rounded-full text-sm font-medium\">#NeighborhoodWatch</span>\n</div>\n</div>\n<!-- Recent Posts -->\n<div class=\"card bg-white p-6 mb-8\">\n<h2 class=\"text-xl font-bold text-gray-800 mb-4 flex items-center\">\n<i class=\"fas fa-comments mr-2 text-secondary\"></i> Recent Posts\n            </h2>\n<div class=\"space-y-4\">\n<!-- Post 1 -->\n<div class=\"border border-gray-200 rounded-lg p-4 hover:bg-gray-50 transition-colors\">\n<div class=\"flex justify-between items-start\">\n<div>\n<div class=\"flex items-center\">\n<span class=\"font-semibold text-gray-800\">John Smith</span>\n<span class=\"mx-2 text-gray-400\">\u2022</span>\n<span class=\"text-sm text-gray-600\">Twitter/X</span>\n</div>\n<p class=\"mt-2 text-gray-700\" data-slot=\"s15\">Just witnessed suspicious activity near the downtown mall. Security should be alerted immediately. #CommunitySafety</p>\n</div>\n<span class=\"sentiment-negative px-2 py-1 rounded-full text-xs font-medium\">Negative</span>\n</div>\n<div class=\"mt-3 flex justify-between text-sm text-gray-500\">\n<span>2 hours ago</span>\n<div class=\"flex space-x-4\">\n<span><i class=\"fas fa-heart mr-1\"></i> 42</span>\n<span><i class=\"fas fa-comment mr-1\"></i> 8</span>\n<span><i class=\"fas fa-share mr-1\"></i> 3</span>\n</div>\n</div>\n</div>\n<!-- Post 2 -->\n<div class=\"border border-gray-200 rounded-lg p-4 hover:bg-gray-50 transition-colors\">\n<div class=\"flex justify-between items-start\">\n<div>\n<div class=\"flex items-center\">\n<span class=\"font-semibold text-gray-800\">Sarah Johnson</span>\n<span class=\"mx-2 text-gray-400\">\u2022</span>\n<span class=\"text-sm text-gray-600\">Instagram</span>\n</div>\n<p class=\"mt-2 text-gray-700\" data-slot=\"s16\">Great job by the local police during tonight's community patrol! Thank you for keeping our neighborhood safe. #PublicAlerts</p>\n</div>\n<span class=\"sentiment-positive px-2 py-1 rounded-full text-xs font-medium\">Positive</span>\n</div>\n<div class=\"mt-3 flex justify-between text-sm text-gray-500\">\n<span>4 hours ago</span>\n<div class=\"flex space-x-4\">\n<span><i class=\"fas fa-heart mr-1\"></i> 128</span>\n<span><i class=\"fas fa-comment mr-1\"></i> 24</span>\n<span><i class=\"fas fa-share mr-1\"></i> 11</span>\n</div>\n</div>\n</div>\n</div>\n</div>\n<!-- Additional Charts Section -->\n<div class=\"grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8\">\n<!-- Volume Anomalies -->\n<div class=\"card bg-white p-6\">\n<h2 class=\"text-xl font-bold text-gray-800 mb-4 flex items-center\">\n<i class=\"fas fa-chart-line mr-2 text-primary\"></i> Volume Trends\n                </h2>\n<div class=\"h-48 flex items-end justify-between space-x-1\">\n<div class=\"flex flex-col items-center w-full\">\n<div class=\"w-3/4 bg-blue-500 rounded-t-md\" style=\"height: 20%\"></div>\n<span class=\"text-xs mt-1\">Mon</span>\n</div>\n<div c