{"head_html": "<head>\n<meta charset=\"utf-8\"/>\n<meta content=\"width=device-width, initial-scale=1.0\" name=\"viewport\"/>\n<title>Intelligence Report - Social Media Monitoring</title>\n<script src=\"https://cdn.tailwindcss.com\"></script>\n<link href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css\" rel=\"stylesheet\"/>\n<script>\n        tailwind.config = {\n            theme: {\n                extend: {\n                    colors: {\n                        primary: '#1a365d',\n                        secondary: '#2d5a8c',\n                        accent: '#4a90e2',\n                        dark: '#0f172a',\n                        light: '#f8fafc'\n                    }\n                }\n            }\n        }\n    </script>\n<style>\n        .three-d-card {\n            transition: transform 0.3s ease, box-shadow 0.3s ease;\n            transform-style: preserve-3d;\n        }\n        .three-d-card:hover {\n            transform: translateY(-5px) rotateX(5deg);\n            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);\n        }\n        .chart-bar {\n            transition: height 0.5s ease;\n        }\n        .section-title {\n            position: relative;\n            padding-bottom: 10px;\n        }\n        .section-title:after {\n            content: '';\n            position: absolute;\n            bottom: 0;\n            left: 0;\n            width: 60px;\n            height: 3px;\n            background: #4a90e2;\n            border-radius: 3px;\n        }\n        .chip {\n            background: linear-gradient(135deg, #4a90e2, #1a365d);\n            color: white;\n            font-size: 0.8rem;\n        }\n        .sentiment-positive {\n            background-color: rgba(72, 187, 120, 0.2);\n            border: 1px solid #48bb78;\n        }\n        .sentiment-negative {\n            background-color: rgba(239, 68, 68, 0.2);\n            border: 1px solid #ef4444;\n        }\n        .sentiment-neutral {\n            background-color: rgba(148, 163, 184, 0.2);\n            border: 1px solid #94a3b8;\n        }\n    </style>\n</head>", "tagged_body_html": "<body class=\"bg-gray-50 text-gray-800 font-sans\">\n<div class=\"max-w-4xl mx-auto px-4 py-8\">\n<!-- Header -->\n<header class=\"mb-12 text-center\">\n<h1 class=\"text-4xl font-bold text-primary mb-2\">Social Media Intelligence Report</h1>\n<p class=\"text-lg text-secondary\">Police &amp; Public Safety Monitoring Dashboard</p>\n<div class=\"mt-4 flex justify-center items-center\">\n<div class=\"w-16 h-16 rounded-full bg-accent flex items-center justify-center\">\n<i class=\"fas fa-shield-alt text-white text-2xl\"></i>\n</div>\n</div>\n</header>\n<!-- Summary Stats -->\n<section class=\"mb-12 three-d-card bg-white rounded-xl shadow-md p-6\">\n<h2 class=\"section-title text-2xl font-bold mb-6\">Platform Distribution &amp; Engagement Overview</h2>\n<div class=\"grid grid-cols-1 md:grid-cols-2 gap-8\">\n<!-- Platform Distribution -->\n<div class=\"space-y-4\">\n<h3 class=\"text-xl font-semibold text-secondary\">Platform Distribution</h3>\n<div class=\"space-y-3\">\n<div class=\"flex justify-between items-center\">\n<span class=\"flex items-center\">\n<i class=\"fab fa-twitter text-blue-400 mr-2\"></i>\n                                Twitter/X\n                            </span>\n<span class=\"font-bold\" data-slot=\"s1\">34%</span>\n</div>\n<div class=\"w-full bg-gray-200 rounded-full h-2.5\">\n<div class=\"bg-blue-600 h-2.5 rounded-full\" style=\"width: 34%\"></div>\n</div>\n<div class=\"flex justify-between items-center\">\n<span class=\"flex items-center\">\n<i class=\"fab fa-instagram text-pink-500 mr-2\"></i>\n                                Instagram\n                            </span>\n<span class=\"font-bold\" data-slot=\"s2\">28%</span>\n</div>\n<div class=\"w-full bg-gray-200 rounded-full h-2.5\">\n<div class=\"bg-pink-500 h-2.5 rounded-full\" style=\"width: 28%\"></div>\n</div>\n<div class=\"flex justify-between items-center\">\n<span class=\"flex items-center\">\n<i class=\"fab fa-facebook text-blue-600 mr-2\"></i>\n                                Facebook\n                            </span>\n<span class=\"font-bold\" data-slot=\"s3\">22%</span>\n</div>\n<div class=\"w-full bg-gray-200 rounded-full h-2.5\">\n<div class=\"bg-blue-700 h-2.5 rounded-full\" style=\"width: 22%\"></div>\n</div>\n<div class=\"flex justify-between items-center\">\n<span class=\"flex items-center\">\n<i class=\"fab fa-youtube text-red-500 mr-2\"></i>\n                                YouTube\n                            </span>\n<span class=\"font-bold\" data-slot=\"s4\">10%</span>\n</div>\n<div class=\"w-full bg-gray-200 rounded-full h-2.5\">\n<div class=\"bg-red-500 h-2.5 rounded-full\" style=\"width: 10%\"></div>\n</div>\n<div class=\"flex justify-between items-center\">\n<span class=\"flex items-center\">\n<i class=\"fab fa-whatsapp text-green-500 mr-2\"></i>\n                                WhatsApp\n                            </span>\n<span class=\"font-bold\" data-slot=\"s5\">6%</span>\n</div>\n<div class=\"w-full bg-gray-200 rounded-full h-2.5\">\n<div class=\"bg-green-500 h-2.5 rounded-full\" style=\"width: 6%\"></div>\n</div>\n</div>\n</div>\n<!-- Engagement Metrics -->\n<div class=\"space-y-6\">\n<h3 class=\"text-xl font-semibold text-secondary\">Engagement Totals</h3>\n<div class=\"grid grid-cols-2 gap-4\">\n<div class=\"bg-light p-4 rounded-lg text-center\">\n<div class=\"text-3xl font-bold text-primary\" data-slot=\"s6\">1,284</div>\n<div class=\"text-sm text-gray-600\">Total Posts</div>\n</div>\n<div class=\"bg-light p-4 rounded-lg text-center\">\n<div class=\"text-3xl font-bold text-accent\" data-slot=\"s7\">4,321</div>\n<div class=\"text-sm text-gray-600\">Total Engagements</div>\n</div>\n<div class=\"bg-light p-4 rounded-lg text-center\">\n<div class=\"text-3xl font-bold text-primary\" data-slot=\"s8\">1,876</div>\n<div class=\"text-sm text-gray-600\">Likes</div>\n</div>\n<div class=\"bg-light p-4 rounded-lg text-center\">\n<div class=\"text-3xl font-bold text-accent\" data-slot=\"s9\">543</div>\n<div class=\"text-sm text-gray-600\">Comments</div>\n</div>\n</div>\n<div class=\"pt-4\">\n<h4 class=\"font-semibold mb-3\">Engagement Breakdown</h4>\n<div class=\"space-y-2\">\n<div class=\"flex justify-between\">\n<span>Shares</span>\n<span class=\"font-medium\" data-slot=\"s10\">234</span>\n</div>\n<div class=\"flex justify-between\">\n<span>Views</span>\n<span class=\"font-medium\" data-slot=\"s11\">3,087</span>\n</div>\n</div>\n</div>\n</div>\n</div>\n</section>\n<!-- Sentiment Analysis -->\n<section class=\"mb-12 three-d-card bg-white rounded-xl shadow-md p-6\">\n<h2 class=\"section-title text-2xl font-bold mb-6\">Sentiment Analysis</h2>\n<div class=\"grid grid-cols-1 md:grid-cols-3 gap-6\">\n<div class=\"bg-light p-6 rounded-lg text-center\">\n<div class=\"text-4xl font-bold text-red-500 mb-2\" data-slot=\"s12\">32%</div>\n<div class=\"text-lg font-semibold text-gray-700\">Negative</div>\n<div class=\"w-full bg-gray-200 rounded-full h-2 mt-3\">\n<div class=\"bg-red-500 h-2 rounded-full\" style=\"width: 32%\"></div>\n</div>\n</div>\n<div class=\"bg-light p-6 rounded-lg text-center\">\n<div class=\"text-4xl font-bold text-yellow-500 mb-2\" data-slot=\"s13\">28%</div>\n<div class=\"text-lg font-semibold text-gray-700\">Neutral</div>\n<div class=\"w-full bg-gray-200 rounded-full h-2 mt-3\">\n<div class=\"bg-yellow-500 h-2 rounded-full\" style=\"width: 28%\"></div>\n</div>\n</div>\n<div class=\"bg-light p-6 rounded-lg text-center\">\n<div class=\"text-4xl font-bold text-green-500 mb-2\" data-slot=\"s14\">40%</div>\n<div class=\"text-lg font-semibold text-gray-700\">Positive</div>\n<div class=\"w-full bg-gray-200 rounded-full h-2 mt-3\">\n<div class=\"bg-green-500 h-2 rounded-full\" style=\"width: 40%\"></div>\n</div>\n</div>\n</div>\n</section>\n<!-- Keywords & Hashtags -->\n<section class=\"mb-12 three-d-card bg-white rounded-xl shadow-md p-6\">\n<h2 class=\"section-title text-2xl font-bold mb-6\">Key Topics &amp; Keywords</h2>\n<div class=\"flex flex-wrap gap-3\" data-slot=\"s15\">\n<span class=\"chip px-4 py-2 rounded-full\">public safety</span>\n<span class=\"chip px-4 py-2 rounded-full\">community concerns</span>\n<span class=\"chip px-4 py-2 rounded-full\">emergency response</span>\n<span class=\"chip px-4 py-2 rounded-full\">social unrest</span>\n<span class=\"chip px-4 py-2 rounded-full\">crime prevention</span>\n</div>\n</section>\n<!-- Recent Posts -->\n<section class=\"mb-12 three-d-card bg-white rounded-xl shadow-md p-6\">\n<h2 class=\"section-title text-2xl font-bold mb-6\">Recent Posts</h2>\n<div class=\"space-y-6\">\n<!-- Post 1 -->\n<div class=\"border border-gray-200 rounded-lg p-4 hover:border-accent transition-colors\">\n<div class=\"flex justify-between items-start mb-3\">\n<div class=\"flex items-center\">\n<div class=\"w-10 h-10 rounded-full bg-gray-300 flex items-center justify-center mr-3\">\n<i class=\"fas fa-user text-gray-600\"></i>\n</div>\n<div>\n<div class=\"font-semibold\">Sarah Johnson</div>\n<div class=\"text-sm text-gray-500\">Twitter/X \u2022 2 hours ago</div>\n</div>\n</div>\n<span class=\"sentiment-negative px-3 py-1 rounded-full text-xs font-medium\">Negative</span>\n</div>\n<p class=\"mb-3\" data-slot=\"s16\">Concerned about recent increase in street crime in downtown area. Police presence seems insufficient during evening hours. #CommunitySafety</p>\n<div class=\"flex space-x-4 text-gray-500\">\n<span><i class=\"far fa-heart mr-1\"></i> 42</span>\n<span><i class=\"far fa-comment mr-1\"></i> 8</span>\n<span><i class=\"fas fa-share mr-1\"></i> 3</span>\n</div>\n</div>\n<!-- Post 2 -->\n<div class=\"border border-gray-200 rounded-lg p-4 hover:border-accent transition-colors\">\n<div class=\"flex justify-between items-start mb-3\">\n<div class=\"flex items-center\">\n<div class=\"w-10 h-10 rounded-full bg-gray-300 flex items-center justify-center mr-3\">\n<i class=\"fas fa-user text-gray-600\"></i>\n</div>\n<div>\n<div class=\"font-semibold\">Mike Rodriguez</div>\n<div class=\"text-sm text-gray-500\">Instagram \u2022 5 hours ago</div>\n</div>\n</div>\n<span class=\"sentiment-positive px-3 py-1 rounded-full text-xs font-medium\">Positive</span>\n</div>\n<p class=\"mb-3\" data-slot=\"s17\">Great job by local police for organizing community safety walk this weekend! Thanks for keeping our neighborhood secure. #PublicSafety</p>\n<div class=\"flex space-x-4 text-gray-500\">\n<span><i class=\"far fa-heart mr-1\"></i> 127</span>\n<span><i class=\"far fa-comment mr-1\"></i> 24</span>\n<span><i class=\"fas fa-share mr-1\"></i> 12</span>\n</div>\n</div>\n</div>\n</section>\n<!-- Technical Specifications -->\n<section class=\"three-d-card bg-white rounded-xl shadow-md p-6\">\n<h2 class=\"section-title text-2xl font-bold mb-6\">Technical Specifications</h2>\n<div class=\"grid grid-cols-1 md:grid-cols-2 gap-6\">\n<div>\n<h3 class=\"text-lg font-semibold mb-3 text-secondary\">Data Collection</h3>\n<ul class=\"space-y-2\">\n<li class=\"flex items-start\">\n<i class=\"fas fa-check-circle text-green-500 mt-1 mr-2\"></i>\n<span>Real-time monitoring across 5 major platforms</span>\n</li>\n<li class=\"flex items-start\">\n<i class=\"fas fa-check-circle text-green-500 mt-1 mr-2\"></i>\n<span>24/7 automated analysis engine</span>\n</li>\n<li class=\"flex items-start\">\n<i class=\"fas fa-check-circle text-green-500 mt-1 mr-2\"></i>\n<span>Multi-language support (English, Spanish, French)</span>\n</li>\n</ul>\n</div>\n<div>\n<h3 class=\"text-lg font-semibold mb-3 text-secondary\">Rendering Details</h3>\n<ul class=\"space-y-2\">\n<li class=\"flex items-start\">\n<i class=\"fas fa-check-circle text-green-500 mt-1 mr-2\"></i>\n<span>3D visualization layer for sentiment mapping</span>\n</li>\n<li class=\"flex items-start\">\n<i class=\"fas fa-check-circle text-green-500 mt-1 mr-2\"></i>\n<span>Dynamic chart generation with SVG</span>\n</li>\n<li class=\"flex items-start\">\n<i class=\"fas fa-check-circle text-green-500 mt-1 mr-2\"></i>\n<span>Responsive design optimized for PDF export</span>\n</li>\n</ul>\n</div>\n</div>\n</section>\n<!-- Footer -->\n<footer class=\"mt-12 pt-6 border-t border-gray-200 text-center text-gray-500 text-sm\">\n<p>Intelligence Report Generated: June 15, 2023</p>\n<p class=\"mt-2\" data-slot=\"s18\">This report is for internal use only. Data is updated daily.</p>\n</footer>\n</div>\n</body>", "slots": [{"slot_id": "s1", "slot_type": "stat_number", "sample_text": "34%", "context_label": "Twitter/X", "chips": [], "meaning_text": "", "maps_to": "platform_counts.TWITTER", "status": "clean"}, {"slot_id": "s2", "slot_type": "stat_number", "sample_text": "28%", "context_label": "", "chips": [], "meaning_text": "", "maps_to": null, "status": "clean"}, {"slot_id": "s3", "slot_type": "stat_number", "sample_text": "22%", "context_label": "", "chips": [], "meaning_text": "", "maps_to": null, "status": "clean"}, {"slot_id": "s4", "slot_type": "stat_number", "sample_text": "10%", "context_label": "YouTube", "chips": [], "meaning_text": "", "maps_to": "platform_counts.YouTube", "status": "clean"}, {"slot_id": "s5", "slot_type": "stat_number", "sample_text": "6%", "context_label": "WhatsApp", "chips": [], "meaning_text": "", "maps_to": "platform_counts.whatsapp", "status": "clean"}, {"slot_id": "s6", "slot_type": "stat_number", "sample_text": "1,284", "context_label": "", "chips": [], "meaning_text": "", "maps_to": null, "status": "clean"}, {"slot_id": "s7", "slot_type": "stat_number", "sample_text": "4,321", "context_label": "", "chips": [], "meaning_text": "", "maps_to": null, "status": "clean"}, {"slot_id": "s8", "slot_type": "stat_number", "sample_text": "1,876", "context_label": "", "chips": [], "meaning_text": "", "maps_to": null, "status": "clean"}, {"slot_id": "s9", "slot_type": "stat_number", "sample_text": "543", "context_label": "", "chips": [], "mean