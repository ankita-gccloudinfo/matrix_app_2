{"head_html": "<head>\n<meta charset=\"utf-8\"/>\n<meta content=\"width=device-width, initial-scale=1.0\" name=\"viewport\"/>\n<title>Intelligence Report - Social Media Monitoring</title>\n<script src=\"https://cdn.tailwindcss.com\"></script>\n<style>\n        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');\n        \n        body {\n            font-family: 'Inter', sans-serif;\n            background-color: #f8fafc;\n            color: #1e293b;\n        }\n        \n        .sentiment-positive {\n            background-color: #dcfce7;\n            color: #166534;\n        }\n        \n        .sentiment-neutral {\n            background-color: #fef3c7;\n            color: #92400e;\n        }\n        \n        .sentiment-negative {\n            background-color: #fee2e2;\n            color: #b91c1c;\n        }\n        \n        .platform-twitter {\n            border-left: 4px solid #1da1f2;\n        }\n        \n        .platform-instagram {\n            border-left: 4px solid #e1306c;\n        }\n        \n        .platform-facebook {\n            border-left: 4px solid #4267B2;\n        }\n        \n        .platform-youtube {\n            border-left: 4px solid #ff0000;\n        }\n        \n        .platform-whatsapp {\n            border-left: 4px solid #25d366;\n        }\n        \n        .card-shadow {\n            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);\n        }\n        \n        .header-gradient {\n            background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);\n            color: white;\n        }\n        \n        .section-header {\n            border-bottom: 2px solid #e2e8f0;\n            padding-bottom: 0.5rem;\n            margin-bottom: 1.5rem;\n        }\n        \n        .chart-bar {\n            transition: height 0.5s ease;\n        }\n    </style>\n</head>", "tagged_body_html": "<body class=\"min-h-screen p-6 max-w-4xl mx-auto bg-white\">\n<!-- Header -->\n<header class=\"header-gradient rounded-xl p-6 mb-8\">\n<div class=\"flex justify-between items-start\">\n<div>\n<h1 class=\"text-3xl font-bold\">Social Media Intelligence Report</h1>\n<p class=\"mt-2 opacity-90\">Monitoring &amp; Analysis Dashboard</p>\n</div>\n<div class=\"text-right\">\n<p class=\"text-sm opacity-75\">Generated: <span id=\"report-date\">October 25, 2023</span></p>\n<p class=\"text-sm opacity-75\">Period: Last 24 hours</p>\n</div>\n</div>\n</header>\n<!-- Summary Stats -->\n<section class=\"mb-8\">\n<h2 class=\"section-header text-xl font-semibold\">Summary Overview</h2>\n<div class=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4\">\n<div class=\"bg-white p-4 rounded-lg card-shadow border border-gray-100\">\n<p class=\"text-sm text-gray-500\">Total Mentions</p>\n<p class=\"text-2xl font-bold mt-1\" data-slot=\"s1\">1,284</p>\n</div>\n<div class=\"bg-white p-4 rounded-lg card-shadow border border-gray-100\">\n<p class=\"text-sm text-gray-500\">Engagement Rate</p>\n<p class=\"text-2xl font-bold mt-1\" data-slot=\"s2\">3.2%</p>\n</div>\n<div class=\"bg-white p-4 rounded-lg card-shadow border border-gray-100\">\n<p class=\"text-sm text-gray-500\">Active Platforms</p>\n<p class=\"text-2xl font-bold mt-1\" data-slot=\"s3\">5</p>\n</div>\n<div class=\"bg-white p-4 rounded-lg card-shadow border border-gray-100\">\n<p class=\"text-sm text-gray-500\">Report Duration</p>\n<p class=\"text-2xl font-bold mt-1\">24 hrs</p>\n</div>\n</div>\n</section>\n<!-- Sentiment Analysis -->\n<section class=\"mb-8\">\n<h2 class=\"section-header text-xl font-semibold\">Sentiment Analysis</h2>\n<div class=\"grid grid-cols-1 md:grid-cols-3 gap-4\">\n<div class=\"bg-white p-4 rounded-lg card-shadow border border-gray-100\">\n<div class=\"flex justify-between items-center mb-2\">\n<span class=\"font-medium\">Negative</span>\n<span class=\"sentiment-negative px-2 py-1 rounded-full text-xs font-medium\" data-slot=\"s4\">42%</span>\n</div>\n<div class=\"w-full bg-gray-200 rounded-full h-2.5\">\n<div class=\"bg-red-500 h-2.5 rounded-full\" style=\"width: 42%\"></div>\n</div>\n</div>\n<div class=\"bg-white p-4 rounded-lg card-shadow border border-gray-100\">\n<div class=\"flex justify-between items-center mb-2\">\n<span class=\"font-medium\">Neutral</span>\n<span class=\"sentiment-neutral px-2 py-1 rounded-full text-xs font-medium\" data-slot=\"s5\">38%</span>\n</div>\n<div class=\"w-full bg-gray-200 rounded-full h-2.5\">\n<div class=\"bg-amber-500 h-2.5 rounded-full\" style=\"width: 38%\"></div>\n</div>\n</div>\n<div class=\"bg-white p-4 rounded-lg card-shadow border border-gray-100\">\n<div class=\"flex justify-between items-center mb-2\">\n<span class=\"font-medium\">Positive</span>\n<span class=\"sentiment-positive px-2 py-1 rounded-full text-xs font-medium\" data-slot=\"s6\">20%</span>\n</div>\n<div class=\"w-full bg-gray-200 rounded-full h-2.5\">\n<div class=\"bg-green-500 h-2.5 rounded-full\" style=\"width: 20%\"></div>\n</div>\n</div>\n</div>\n</section>\n<!-- Platform Distribution -->\n<section class=\"mb-8\">\n<h2 class=\"section-header text-xl font-semibold\">Platform Distribution</h2>\n<div class=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-4\">\n<div class=\"bg-white p-4 rounded-lg card-shadow border border-gray-100\">\n<div class=\"flex items-center\">\n<div class=\"w-10 h-10 rounded-full bg-blue-100 flex items-center justify-center mr-3\">\n<span class=\"text-blue-600 font-bold\">X</span>\n</div>\n<div>\n<p class=\"font-medium\">Twitter</p>\n<p class=\"text-sm text-gray-500\" data-slot=\"s7\">32%</p>\n</div>\n</div>\n</div>\n<div class=\"bg-white p-4 rounded-lg card-shadow border border-gray-100\">\n<div class=\"flex items-center\">\n<div class=\"w-10 h-10 rounded-full bg-pink-100 flex items-center justify-center mr-3\">\n<span class=\"text-pink-600 font-bold\">IG</span>\n</div>\n<div>\n<p class=\"font-medium\">Instagram</p>\n<p class=\"text-sm text-gray-500\" data-slot=\"s8\">28%</p>\n</