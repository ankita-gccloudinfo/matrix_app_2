{"head_html": "<head>\n<meta charset=\"utf-8\"/>\n<meta content=\"width=device-width, initial-scale=1.0\" name=\"viewport\"/>\n<title>Social Media Intelligence Report</title>\n<script src=\"https://cdn.tailwindcss.com\"></script>\n<link href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css\" rel=\"stylesheet\"/>\n<script>\n        tailwind.config = {\n            theme: {\n                extend: {\n                    colors: {\n                        primary: '#2563eb',\n                        secondary: '#1e40af',\n                        accent: '#f8fafc',\n                        dark: '#0f172a',\n                        light: '#f1f5f9'\n                    }\n                }\n            }\n        }\n    </script>\n<style>\n        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');\n        body {\n            font-family: 'Inter', sans-serif;\n            background-color: #f8fafc;\n        }\n        .card {\n            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);\n            transition: all 0.3s ease;\n        }\n        .card:hover {\n            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);\n        }\n        .sentiment-negative {\n            background-color: #fee2e2;\n            color: #b91c1c;\n        }\n        .sentiment-neutral {\n            background-color: #fef3c7;\n            color: #92400e;\n        }\n        .sentiment-positive {\n            background-color: #dcfce7;\n            color: #166534;\n        }\n        .platform-twitter {\n            border-left: 4px solid #1da1f2;\n        }\n        .platform-instagram {\n            border-left: 4px solid #e1306c;\n        }\n        .platform-facebook {\n            border-left: 4px solid #1877f2;\n        }\n        .platform-youtube {\n            border-left: 4px solid #ff0000;\n        }\n        .platform-whatsapp {\n            border-left: 4px solid #25d366;\n        }\n        .chart-bar {\n            transition: height 0.5s ease;\n        }\n    </style>\n</head>", "tagged_body_html": "<body class=\"bg-accent text-dark\">\n<div class=\"max-w-4xl mx-auto px-4 py-8\">\n<!-- Header -->\n<header class=\"mb-10\">\n<div class=\"flex justify-between items-start\">\n<div>\n<h1 class=\"text-3xl font-bold text-primary\">Social Media Intelligence Report</h1>\n<p class=\"text-gray-600 mt-2\">Public Safety Monitoring Dashboard</p>\n</div>\n<div class=\"text-right\">\n<p class=\"text-sm text-gray-500\">Generated: <span class=\"font-medium\">November 15, 2023</span></p>\n<p class=\"text-sm text-gray-500\">Period: <span class=\"font-medium\">Last 24 hours</span></p>\n</div>\n</div>\n<div class=\"mt-6 h-1 bg-primary rounded-full\"></div>\n</header>\n<!-- Summary Stats -->\n<section class=\"mb-10\">\n<h2 class=\"text-xl font-semibold mb-4 text-secondary\">Report Overview</h2>\n<div class=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4\">\n<div class=\"card bg-white p-6 rounded-lg\">\n<div class=\"flex items-center\">\n<div class=\"p-3 rounded-full bg-blue-100 text-blue-600 mr-4\">\n<i class=\"fas fa-comments\"></i>\n</div>\n<div>\n<p class=\"text-gray-500 text-sm\">Total Mentions</p>\n<p class=\"text-2xl font-bold\" data-slot=\"s1\">1,284</p>\n</div>\n</div>\n</div>\n<div class=\"card bg-white p-6 rounded-lg\">\n<div class=\"flex items-center\">\n<div class=\"p-3 rounded-full bg-green-100 text-green-600 mr-4\">\n<i class=\"fas fa-chart-line\"></i>\n</div>\n<div>\n<p class=\"text-gray-500 text-sm\">Engagement Rate</p>\n<p class=\"text-2xl font-bold\" data-slot=\"s2\">24.7%</p>\n</div>\n</div>\n</div>\n<div class=\"card bg-white p-6 rounded-lg\">\n<div class=\"flex items-center\">\n<div class=\"p-3 rounded-full bg-purple-100 text-purple-600 mr-4\">\n<i class=\"fas fa-users\"></i>\n</div>\n<div>\n<p class=\"text-gray-500 text-sm\">Unique Authors</p>\n<p class=\"text-2xl font-bold\" data-slot=\"s3\">86</p>\n</div>\n</div>\n</div>\n<div class=\"card bg-white p-6 rounded-lg\">\n<div class=\"flex items-center\">\n<div class=\"p-3 rounded-full bg-orange-100 text-orange-600 mr-4\">\n<i class=\"fas fa-globe-americas\"></i>\n</div>\n<div>\n<p class=\"text-gray-500 text-sm\">Platforms Monitored</p>\n<p class=\"text-2xl font-bold\" data-slot=\"s4\">5</p>\n</div>\n</div>\n</div>\n</div>\n</section>\n<!-- Sentiment Analysis -->\n<section class=\"mb-10\">\n<h2 class=\"text-xl font-semibold mb-4 text-secondary\">Sentiment Analysis</h2>\n<div class=\"card bg-white p-6 rounded-lg\">\n<div class=\"grid grid-cols-1 md:grid-cols-3 gap-6\">\n<div class=\"flex flex-col items-center justify-center\">\n<div class=\"relative w-48 h-48\">\n<svg class=\"w-full h-full\" viewbox=\"0 0 36 36\">\n<path d=\"M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831\" fill=\"none\" stroke=\"#e2e8f0\" stroke-width=\"3\"></path>\n<path d=\"M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831\" fill=\"none\" stroke=\"#ef4444\" stroke-dasharray=\"30, 100\" stroke-width=\"3\"></path>\n</svg>\n<div class=\"absolute inset-0 flex flex-col items-center justify-center\">\n<span class=\"text-2xl font-bold\" data-slot=\"s5\">32%</span>\n<span class=\"text-xs text-gray-500\">Negative</span>\n</div>\n</div>\n</div>\n<div class=\"flex flex-col items-center justify-center\">\n<div class=\"relative w-48 h-48\">\n<svg class=\"w-full h-full\" viewbox=\"0 0 36 36\">\n<path d=\"M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831\" fill=\"none\" stroke=\"#e2e8f0\" stroke-width=\"3\"></path>\n<path d=\"M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831\" fill=\"none\" stroke=\"#f59e0b\" stroke-dasharray=\"45, 100\" stroke-width=\"3\"></path>\n</svg>\n<div class=\"absolute inset-0 flex flex-col items-center justify-center\">\n<span class=\"text-2xl font-bold\" data-slot=\"s6\">45%</span>\n<span class=\"text-x