{"head_html": "<head>\n<meta charset=\"utf-8\"/>\n<meta content=\"width=device-width, initial-scale=1.0\" name=\"viewport\"/>\n<title>Social Media Intelligence Report</title>\n<script src=\"https://cdn.tailwindcss.com\"></script>\n<link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&amp;display=swap\" rel=\"stylesheet\"/>\n<style>\n        body {\n            font-family: 'Inter', sans-serif;\n            background-color: #f8fafc;\n        }\n        .card {\n            border-radius: 12px;\n            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.02);\n        }\n        .gradient-bg {\n            background: linear-gradient(135deg, #4f46e5 0%, #0d9488 100%);\n        }\n        .sentiment-negative {\n            background-color: #fee2e2;\n            color: #dc2626;\n        }\n        .sentiment-neutral {\n            background-color: #fef3c7;\n            color: #d97706;\n        }\n        .sentiment-positive {\n            background-color: #dcfce7;\n            color: #166534;\n        }\n        .chart-bar {\n            transition: height 0.5s ease;\n        }\n        .district-tag {\n            background: linear-gradient(135deg, #6366f1 0%, #0d9488 100%);\n            color: white;\n        }\n    </style>\n</head>", "tagged_body_html": "<body class=\"bg-gray-50\">\n<!-- Banner Section -->\n<div class=\"gradient-bg text-white p-6\">\n<div class=\"max-w-6xl mx-auto\">\n<h1 class=\"text-2xl md:text-3xl font-bold\">Social Media Intelligence Report</h1>\n<div class=\"mt-4 flex flex-wrap items-center gap-4\">\n<div class=\"bg-white bg-opacity-20 px-4 py-2 rounded-lg\">\n<span class=\"text-sm opacity-80\">Total Posts</span>\n<div class=\"text-xl font-bold\" data-slot=\"s1\">1,284</div>\n</div>\n<div class=\"bg-white bg-opacity-20 px-4 py-2 rounded-lg\">\n<span class=\"text-sm opacity-80\">Top District</span>\n<div class=\"text-xl font-bold\">Downtown</div>\n</div>\n<div class=\"bg-white bg-opacity-20 px-4 py-2 rounded-lg\">\n<span class=\"text-sm opacity-80\">Report Period</span>\n<div class=\"text-xl font-bold\">Last 24 Hours</div>\n</div>\n</div>\n</div>\n</div>\n<div class=\"max-w-6xl mx-auto p-4 md:p-6\">\n<!-- Sentiment Analysis -->\n<section class=\"mb-8 card bg-white p-6\">\n<h2 class=\"text-xl font-bold mb-4 text-gray-800\">Sentiment Analysis</h2>\n<div class=\"grid grid-cols-1 md:grid-cols-3 gap-4\">\n<div class=\"flex flex-col items-center justify-center p-4 bg-red-50 rounded-lg\">\n<div class=\"text-3xl font-bold text-red-600\" data-slot=\"s2\">42%</div>\n<div class=\"text-gray-600 mt-1\">Negative</div>\n</div>\n<div class=\"flex flex-col items-center justify-center p-4 bg-yellow-50 rounded-lg\">\n<div class=\"text-3xl font-bold text-yellow-600\" data-slot=\"s3\">38%</div>\n<div class=\"text-gray-600 mt-1\">Neutral</div>\n</div>\n<div class=\"flex flex-col items-center justify-center p-4 bg-green-50 rounded-lg\">\n<div class=\"text-3xl font-bold text-green-600\" data-slot=\"s4\">20%</div>\n<div class=\"text-gray-600 mt-1\">Positive</div>\n</div>\n</div>\n</section>\n<!-- Volume Anomalies -->\n<section class=\"mb-8 card bg-white p-6\">\n<h2 class=\"text-xl font-bold mb-4 text-gray-800\">Volume Anomalies</h2>\n<div class=\"flex items-center justify-between mb-4\">\n<div class=\"text-gray-600\">Post Volume Trend</div>\n<div class=\"text-sm font-medium text-indigo-600\">+12% vs previous period</div>\n</div>\n<div class=\"h-32 flex items-end space-x-2\">\n<div class=\"flex-1 bg-indigo-500 chart-bar\" style=\"height: 40%\"></div>\n<div class=\"flex-1 bg-indigo-500 chart-bar\" style=\"height: 60%\"></div>\n<div class=\"flex-1 bg-indigo-500 chart-bar\" style=\"height: 30%\"></div>\n<div class=\"flex-1 bg-indigo-500 chart-bar\" style=\"height: 75%\"></div>\n<div class=\"flex-1 bg-indigo-500 chart-bar\" style=\"height: 50%\"></div>\n<div class=\"flex-1 bg-indigo-500 chart-bar\" style=\"height: 85%\"></div>\n<div class=\"flex-1 bg-indigo-500 chart-bar\" style=\"height: 65%\"></div>\n</div>\n</section>\n<!-- Platform Comparisons -->\n<section class=\"mb-8 card bg-white p-6\">\n<h2 class=\"text-xl font-bold mb-4 text-gray-800\">Platform Breakdown</h2>\n<div class=\"grid grid-cols-2 md:grid-cols-5 gap-4\">\n<div class=\"flex flex-col items-center p-3 bg-blue-50 rounded-lg\">\n<div class=\"text-2xl font-bold text-blue-600\" data-slot=\"s5\">45%</div>\n<div class=\"text-gray-600 text-sm\">Twitter/X</div>\n</div>\n<div class=\"flex flex-col items-center p-3 bg-purple-50 rounded-lg\">\n<div class=\"text-2xl font-bold text-purple-600\" data-slot=\"s6\">25%</div>\n<div class=\"text-gray-600 text-sm\">Instagram</div>\n</div>\n<div class=\"flex flex-col items-center p-3 bg-pink-50 rounded-lg\">\n<div class=\"text-2xl font-bold text-pink-600\" data-slot=\"s7\">15%</div>\n<div class=\"text-gray-600 text-sm\">Facebook</div>\n</div>\n<div class=\"flex flex-col items-center p-3 bg-red-50 rounded-lg\">\n<div class=\"text-2xl font-bold text-red-600\" data-slot=\"s8\">10%</div>\n<div class=\"text-gray-600 text-sm\">YouTube</div>\n</div>\n<div class=\"flex flex-col items-center p-3 bg-green-50 rounded-lg\">\n<div class=\"text-2xl font-bold text-green-600\" data-slot=\"s9\">5%</div>\n<div class=\"text-gray-600 text-sm\">WhatsApp</div>\n</div>\n</div>\n</section>\n<!-- Keyword Chips -->\n<section class=\"mb-8 card bg-white p-6\">\n<h2 class=\"text-xl font-bold mb-4 text-gray-800\">Key Topics &amp; Hashtags</h2>\n<div class=\"flex flex-wrap gap-2\">\n<span class=\"px-3 py-1 bg-indigo-100 text-indigo-800 rounded-full text-sm\">#CommunitySafety</span>\n<span class=\"px-3 py-1 bg-teal-100 text-teal-800 rounded-full text-sm\">#PublicSafety</span>\n<span class=\"px-3 py-1 bg-blue-100 text-blue-800 rounded-full text-sm\">#PoliceResponse</span>\n<span class=\"px-3 py-1 bg-purple-100 text-purple-800 rounded-full text-sm\">#CrimePrevention</span>\n<span class=\"px-3 py-1 bg-pink-100 text-pink-800 rounded-full text-sm\">#EmergencyServices</span>\n</div>\n</section>\n<!-- Recent Posts -->\n<section class=\"mb-8 card bg-white p-6\">\n<h2 class=\"text-xl font-bold mb-4 text-gray-800\">Recent Posts</h2>\n<div class=\"space-y-4\">\n<!-- Post 1 -->\n<div class=\"border border-gray-200 rounded-lg p-4 hover:shadow-md transition-shadow\">\n<div class=\"flex justify-between items-start\">\n<div>\n<div class=\"font-semibold text-gray-800\">John Smith</div>\n<div class=\"text-sm text-gray-500\">Twitter/X \u2022 2 hours ago</div>\n</div>\n<span class=\"sentiment-negative text-xs px-2 py-1 rounded-full\">Negative</span>\n</div>\n<p class=\"mt-2 text-gray-700\" data-slot=\"s10\">Concerned about increased crime in downtown area. Police response seems slow. #CommunitySafety</p>\n<div class=\"mt-3 flex space-x-3\">\n<span class=\"text-sm text-gray-500\">Likes: 24</span>\n<span class=\"text-sm text-gray-500\">Comments: 8</span>\n<span class=\"text-sm text-gray-500\">Shares: 3</span>\n</div>\n</div>\n<!-- Post 2 -->\n<div class=\"border border-gray-200 rounded-lg p-4 hover:shadow-md transition-shadow\">\n<div class=\"flex justify-between items-start\">\n<div>\n<div class=\"font-semibold text-gray-800\">Sarah Johnson</div>\n<div class=\"text-sm text-gray-500\">Instagram \u2022 4 hours ago</div>\n</div>\n<span class=\"sentiment-positive text-xs px-2 py-1 rounded-full\">Positive</span>\n</div>\n<p class=\"mt-2 text-gray-700\" data-slot=\"s11\">Great job by local officers during yesterday's community event. Thank you for keeping us safe! #PublicSafety</p>\n<div class=\"mt-3 flex space-x-3\">\n<span class=\"text-sm text-gray-500\">Likes: 42</span>\n<span class=\"text-sm text-gray-500\">Comments: 5</span>\n<span class=\"text-sm text-gray-500\">Shares: 1</span>\n</div>\n</div>\n</div>\n</section>\n<!-- Engagement Metrics -->\n<section class=\"mb-8 card bg-white p-6\">\n<h2 class=\"text-xl font-bold mb-4 text-gray-800\">Engagement Metrics</h2>\n<div class=\"grid grid-cols-2 md:grid-cols-4 gap-4\">\n<div class=\"text-center p-4 bg-blue-50 rounded-lg\">\n<div class=\"text-2xl font-bold text-blue-600\" data-slot=\"s12\">1,284</div>\n<div class=\"text-gray-600 mt-1\">Total Posts</div>\n</div>\n<div class=\"text-center p-4 bg-green-50 rounded-lg\">\n<div class=\"text-2xl font-bold text-green-600\" data-slot=\"s13\">856</div>\n<div class=\"text-gray-600 mt-1\">Likes</div>\n</div>\n<div class=\"text-center p-4 bg-yellow-50 rounded-lg\">\n<div class=\"text-2xl font-bold text-yellow-600\" data-slot=\"s14\">321</div>\n<div class=\"text-gray-600 mt-1\">Comments</div>\n</div>\n<div class=\"text-center p-4 bg-purple-50 rounded-lg\">\n<div class=\"text-2xl font-bold text-purple-600\" data-slot=\"s15\">147</div>\n<div class=\"text-gray-600 mt-1\">Shares</div>\n</div>\n</div>\n</section>\n<!-- District Level Data -->\n<section class=\"mb-8 card bg-white p-6\">\n<h2 class=\"text-xl font-bold mb-4 text-gray-800\">District Level Activity</h2>\n<div class=\"overflow-x-auto\">\n<table class=\"min-w-full divide-y divide-gray-200\" data-slot=\"s16\">\n<thead class=\"bg-gray-50\">\n<tr>\n<th class=\"px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider\">District</th>\n<th class=\"px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider\">Posts</th>\n<th class=\"px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider\">Sentiment</th>\n<th class=\"px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider\">Activity</th>\n</tr>\n</thead>\n<tbody class=\"bg-white divide-y divide-gray-200\">\n<tr>\n<td class=\"px-6 py-4 whitespace-nowrap\">Downtown</td>\n<td class=\"px-6 py-4 whitespace-nowrap\">423</td>\n<td class=\"px-6 py-4 whitespace-nowrap\"><span class=\"sentiment-negative text-xs px-2 py-1 rounded-full\">Negative</span></td>\n<td class=\"px-6 py-4 whitespace-nowrap\">High</td>\n</tr>\n<tr>\n<td class=\"px-6 py-4 whitespace-nowrap\">Westside</td>\n<td class=\"px-6 py-4 whitespace-nowrap\">312</td>\n<td class=\"px-6 py-4 whit