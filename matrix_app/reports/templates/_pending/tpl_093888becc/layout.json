ss=\"text-white text-3xl font-bold\" data-slot=\"s4\">10%</span>\n</div>\n<p class=\"font-semibold\">Negative</p>\n</div>\n</div>\n</section>\n<!-- Volume Anomalies -->\n<section class=\"mb-8 card bg-white p-6\">\n<h2 class=\"text-xl font-bold mb-4 flex items-center\">\n<i class=\"fas fa-exclamation-triangle mr-2 text-accent\"></i> Volume Anomalies\n            </h2>\n<div class=\"grid grid-cols-1 md:grid-cols-3 gap-6\">\n<div class=\"border-l-4 border-red-500 pl-4 py-2\">\n<p class=\"font-semibold\">Spike Alert</p>\n<p class=\"text-sm text-gray-600\">15% increase in mentions</p>\n</div>\n<div class=\"border-l-4 border-yellow-500 pl-4 py-2\">\n<p class=\"font-semibold\">Pattern Change</p>\n<p class=\"text-sm text-gray-600\">Shift in conversation topics</p>\n</div>\n<div class=\"border-l-4 border-green-500 pl-4 py-2\">\n<p class=\"font-semibold\">Stable Trend</p>\n<p class=\"text-sm text-gray-600\">Consistent engagement levels</p>\n</div>\n</div>\n</section>\n<!-- Platform Comparison -->\n<section class=\"mb-8 card bg-white p-6\">\n<h2 class=\"text-xl font-bold mb-4 flex items-center\">\n<i class=\"fas fa-chart-bar mr-2 text-secondary\"></i> Platform Comparison\n            </h2>\n<div class=\"space-y-4\">\n<div class=\"flex items-center justify-between\">\n<div class=\"flex items-center\">\n<div class=\"w-8 h-8 rounded-full bg-blue-100 flex items-center justify-center mr-3\">\n<i class=\"fab fa-twitter text-blue-500\"></i>\n</div>\n<span>Twitter/X</span>\n</div>\n<div class=\"w-32 bg-gray-200 rounded-full h-2.5\">\n<div class=\"bg-blue-600 h-2.5 rounded-full\" style=\"width: 75%\"></div>\n</div>\n<span class=\"ml-4 font-semibold\" data-slot=\"s5\">75%</span>\n</div>\n<div class=\"flex items-center justify-between\">\n<div class=\"flex items-center\">\n<div class=\"w-8 h-8 rounded-full bg-pink-100 flex items-center justify-center mr-3\">\n<i class=\"fab fa-instagram text-pink-500\"></i>\n</div>\n<span>Instagram</span>\n</div>\n<div class=\"w-32 bg-gray-200 rounded-full h-2.5\">\n<div class=\"bg-pink-500 h-2.5 rounded-full\" style=\"width: 55%\"></div>\n</div>\n<span class=\"ml-4 font-semibold\" data-slot=\"s6\">55%</span>\n</div>\n<div class=\"flex items-center justify-between\">\n<div class=\"flex items-center\">\n<div class=\"w-8 h-8 rounded-full bg-blue-100 flex items-center justify-center mr-3\">\n<i class=\"fab fa-facebook text-blue-600\"></i>\n</div>\n<span>Facebook</span>\n</div>\n<div class=\"w-32 bg-gray-200 rounded-full h-2.5\">\n<div class=\"bg-blue-500 h-2.5 rounded-full\" style=\"width: 40%\"></div>\n</div>\n<span class=\"ml-4 font-semibold\" data-slot=\"s7\">40%</span>\n</div>\n<div class=\"flex items-center justify-between\">\n<div class=\"flex items-center\">\n<div class=\"w-8 h-8 rounded-full bg-red-100 flex items-center justify-center mr-3\">\n<i class=\"fab fa-youtube text-red-500\"></i>\n</div>\n<span>YouTube</span>\n</div>\n<div class=\"w-32 bg-gray-200 rounded-full h-2.5\">\n<div class=\"bg-red-500 h-2.5 rounded-full\" style=\"width: 25%\"></div>\n</div>\n<span class=\"ml-4 font-semibold\" data-slot=\"s8\">25%</span>\n</div>\n<div class=\"flex items-center justify-between\">\n<div class=\"flex items-center\">\n<div class=\"w-8 h-8 rounded-full bg-green-100 flex items-center justify-center mr-3\">\n<i class=\"fab fa-whatsapp text-green-500\"></i>\n</div>\n<span>WhatsApp</span>\n</div>\n<div class=\"w-32 bg-gray-200 rounded-full h-2.5\">\n<div class=\"bg-green-500 h-2.5 rounded-full\" style=\"width: 15%\"></div>\n</div>\n<span class=\"ml-4 font-semibold\" data-slot=\"s9\">15%</span>\n</div>\n</div>\n</section>\n<!-- Key Words & Hashtags -->\n<section class=\"mb-8 card bg-white p-6\">\n<h2 class=\"text-xl font-bold mb-4 flex items-center\">\n<i class=\"fas fa-tags mr-2 text-primary\"></i> Key Words &amp; Hashtags\n            </h2>\n<div class=\"flex flex-wrap gap-2\" data-slot=\"s10\">\n<span class=\"chip px-3 py-1 rounded-full text-sm font-medium\">#community</span>\n<span class=\"chip px-3 py-1 rounded-full text-sm font-medium\">#safety</span>\n<span class=\"chip px-3 py-1 rounded-full text-sm font-medium\">#violence</span>\n<span class=\"chip px-3 py-1 rounded-full text-sm font-medium\">#reporting</span>\n<span class=\"chip px-3 py-1 rounded-full text-sm font-medium\">#emergency</span>\n</div>\n</section>\n<!-- Recent Posts -->\n<section class=\"mb-8 card bg-white p-6\">\n<h2 class=\"text-xl font-bold mb-4 flex items-center\">\n<i class=\"fas fa-comments mr-2 text-secondary\"></i> Recent Posts\n            </h2>\n<div class=\"space-y-4\">\n<div class=\"border-b pb-4\">\n<div class=\"flex justify-between\">\n<div class=\"flex items-center\">\n<div class=\"w-10 h-10 rounded-full bg-gray-200 flex items-center justify-center mr-3\">\n<i class=\"fas fa-user text-gray-500\"></i>\n</div>\n<div>\n<p class=\"font-semibold\">Alex Johnson</p>\n<p class=\"text-sm text-gray-500\">Twitter/X</p>\n</div>\n</div>\n<span class=\"text-sm text-gray-500\">2 hours ago</span>\n</div>\n<p class=\"mt-2 text-gray-700\" data-slot=\"s11\">Just saw a suspicious person near the downtown library. Should I report this?</p>\n<div class=\"mt-2 flex items-center\">\n<span class=\"text-xs px-2 py-1 bg-green-100 text-green-800 rounded-full\">Positive</span>\n</div>\n</div>\n<div class=\"border-b pb-4\">\n<div class=\"flex justify-between\">\n<div class=\"flex items-center\">\n<div class=\"w-10 h-10 rounded-full bg-gray-200 flex items-center justify-center mr-3\">\n<i class=\"fas fa-user text-gray-500\"></i>\n</div>\n<div>\n<p class=\"font-semibold\">Maria Garcia</p>\n<p class=\"text-sm text-gray-500\">Instagram</p>\n</div>\n</div>\n<span class=\"text-sm text-gray-500\">5 hours ago</span>\n</div>\n<p class=\"mt-2 text-gray-700\" data-slot=\"s12\">Safety concerns in the park area tonight. Need more patrol presence.</p>\n<div class=\"mt-2 flex items-center\">\n<span class=\"text-xs px-2 py-1 bg-red-100 text-red-800 rounded-full\">Negative</span>\n</div>\n</div>\n</div>\n</section>\n<!-- Engagement Metrics -->\n<section class=\"mb-8 card bg-white p-6\">\n<h2 class=\"text-xl font-bold mb-4 flex items-center\">\n<i class=\"fas fa-heart mr-2 text-accent\"></i> Engagement Metrics\n            </h2>\n<div class=\"grid grid-cols-2 md:grid-cols-4 gap-4\">\n<div class=\"text-center p-4 bg-blue-50 rounded-lg\">\n<p class=\"text-2xl font-bold text-blue-600\" data-slot=\"s13\">1,284</p>\n<p class=\"text-sm text-gray-600\">Total Posts</p>\n</div>\n<div class=\"text-center p-4 bg-green-50 rounded-lg\">\n<p class=\"text-2xl font-bold text-green-600\" data-slot=\"s14\">8,421</p>\n<p class=\"text-sm text-gray-600\">Likes</p>\n</div>\n<div class=\"text-center p-4 bg-yellow-50 rounded-lg\">\n<p class=\"text-2xl font-bold text-yellow-600\" data-slot=\"s15\">1,243</p>\n<p class=\"text-sm text-gray-600\">Comments</p>\n</div>\n<div class=\"text-center p-4 bg-purple-50 rounded-lg\">\n<p class=\"text-2xl font-bold text-purple-600\" data-slot=\"s16\">3,842</p>\n<p class=\"text-sm text-gray-600\">Shares</p>\n</div>\n</div>\n</section>\n</div>\n<footer class=\"py-6 text-center text-gray-500 text-sm\">\n<p data-slot=\"s17\">Social Media Intelligence Platform \u2022 Report Generated: June 30, 2023</p>\n</footer>\n</body>", "slots": [{"slot_id": "s1", "slot_type": "stat_number", "sample_text": "1,284", "context_label": "Total Posts", "chips": [], "meaning_text": "", "maps_to": "total_posts", "status": "clean"}, {"slot_id": "s2", "slot_type": "stat_number", "sample_text": "68%", "context_label": "", "chips": [], "meaning_text": "", "maps_to": null, "status": "clean"}, {"slot_id": "s3", "slot_type": "stat_number", "sample_text": "22%", "context_label": "", "chips": [], "meaning_text": "", "maps_to": null, "status": "clean"}, {"slot_id": "s4", "slot_type": "stat_number", "sample_text": "10%", "context_label": "", "chips": [], "meaning_text": "", "maps_to": null, "status": "clean"}, {"slot_id": "s5", "slot_type": "stat_number", "sample_text": "75%", "context_label": "", "chips": [], "meaning_text": "